# --- Обязательные ---

# Токен бота от @BotFather. Можно взять токен robot: бот только отправляет сообщения
# и не забирает апдейты, поэтому с robot не конфликтует.
BOT_TOKEN=123456:your_bot_token_here
# Канал, куда идёт лента: -100... или @username. Бот должен быть в нём админом с правом постить.
CHANNEL_ID=-1001234567890

# Публичный адрес вики, из него собираются ссылки в постах.
OUTLINE_URL=https://wiki.example.org
# Настройки → API keys. Бот видит в вики ровно то, что видит владелец ключа.
OUTLINE_API_KEY=ol_api_...
# Signing secret из настроек вебхука в outline.
WEBHOOK_SECRET=

# --- Опциональные ---

# Адрес outline для запросов к api изнутри docker-сети, напр. http://outline:3000.
# Пусто: берётся OUTLINE_URL.
OUTLINE_API_URL=
# skip (по умолчанию): приватные коллекции в канал не попадают. post: попадают.
PRIVATE_COLLECTIONS=skip
# Сколько пропущенных событий догружать после простоя (более ранние отбрасываются).
BACKFILL_LIMIT=30
PORT=8080
# Для локального запуска; в docker-compose.yaml путь задан внутри тома.
STATE_FILE=./data/state.json
